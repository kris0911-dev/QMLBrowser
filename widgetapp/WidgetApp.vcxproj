<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{8F1C4A21-6D3E-4B5A-9C10-2E7A5B840004}</ProjectGuid>
    <RootNamespace>WidgetApp</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <!-- Whichever toolset this Visual Studio ships: v143 on 2022, v145 on 2026. -->
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' != 'Debug'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
    <Import Project="$(MSBuildThisFileDirectory)..\qt.props" />
  </ImportGroup>

  <!-- Qt SVG and Qt Multimedia are optional, as in CMakeLists.txt. -->
  <PropertyGroup>
    <WidgetAppSvg Condition="Exists('$(QtDir)\lib\Qt6Svg$(QtLibSuffix).lib')">true</WidgetAppSvg>
    <WidgetAppMultimedia Condition="Exists('$(QtDir)\lib\Qt6Multimedia$(QtLibSuffix).lib')">true</WidgetAppMultimedia>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- QtGuiPrivateInclude (qt.props) holds qpa/qwindowsysteminterface.h. -->
      <AdditionalIncludeDirectories>$(RepoRoot)shared;$(QtInclude)\QtCore;$(QtInclude)\QtGui;$(QtGuiPrivateInclude);$(QtInclude)\QtNetwork;$(QtInclude)\QtWidgets;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- Qt6EntryPoint supplies the WinMain that forwards to main(). -->
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>Qt6Core$(QtLibSuffix).lib;Qt6Gui$(QtLibSuffix).lib;Qt6Network$(QtLibSuffix).lib;Qt6Widgets$(QtLibSuffix).lib;Qt6EntryPoint$(QtLibSuffix).lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(WidgetAppSvg)' == 'true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(QtInclude)\QtSvg;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIDGETAPP_HAVE_SVG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>Qt6Svg$(QtLibSuffix).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(WidgetAppMultimedia)' == 'true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(QtInclude)\QtMultimedia;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIDGETAPP_HAVE_MULTIMEDIA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>Qt6Multimedia$(QtLibSuffix).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="BrowserBridge.cpp" />
    <ClCompile Include="ControlsPage.cpp" />
    <ClCompile Include="GalleryWindow.cpp" />
    <ClCompile Include="PaintPage.cpp" />
    <ClCompile Include="PicturePage.cpp" />
    <ClCompile Include="VectorPage.cpp" />
    <ClCompile Include="VideoPage.cpp" />
    <ClCompile Include="$(RepoRoot)shared\IpcChannel.cpp" />
    <ClCompile Include="$(RepoRoot)shared\SharedPixels.cpp" />
    <!-- Generated by the moc step below, before cl.exe runs. -->
    <ClCompile Include="$(QtGenDir)moc_BrowserBridge.cpp" />
    <ClCompile Include="$(QtGenDir)moc_ControlsPage.cpp" />
    <ClCompile Include="$(QtGenDir)moc_GalleryWindow.cpp" />
    <ClCompile Include="$(QtGenDir)moc_PaintPage.cpp" />
    <ClCompile Include="$(QtGenDir)moc_PicturePage.cpp" />
    <ClCompile Include="$(QtGenDir)moc_VectorPage.cpp" />
    <ClCompile Include="$(QtGenDir)moc_VideoPage.cpp" />
    <ClCompile Include="$(QtGenDir)moc_IpcChannel.cpp" />
  </ItemGroup>

  <ItemGroup>
    <CustomBuild Include="BrowserBridge.h;ControlsPage.h;GalleryWindow.h;PaintPage.h;PicturePage.h;VectorPage.h;VideoPage.h;$(RepoRoot)shared\IpcChannel.h">
      <Message>moc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\moc.exe" "%(FullPath)" -o "$(QtGenDir)moc_%(Filename).cpp" -f"%(Filename)%(Extension)"</Command>
      <Outputs>$(QtGenDir)moc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\moc.exe</AdditionalInputs>
    </CustomBuild>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="CheckQtPrivateHeaders" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(QtGuiPrivateInclude)\qpa\qwindowsysteminterface.h')"
           Text="Qt GUI private headers not found at $(QtGuiPrivateInclude). Set QtVersion to the version of the kit in QtDir ($(QtDir))." />
  </Target>

  <Target Name="DeployQtRuntime" AfterTargets="Link">
    <Exec Condition="!Exists('$(OutDir)qtdeploy_widgetapp.stamp')"
          Command="&quot;$(QtBin)\windeployqt.exe&quot; --no-translations --no-compiler-runtime &quot;$(TargetPath)&quot;" />
    <Touch Files="$(OutDir)qtdeploy_widgetapp.stamp" AlwaysCreate="true" />
  </Target>

  <!--
    In a tab the app runs on Qt's offscreen platform, which windeployqt does
    not copy (it deploys qwindows only). Without it the app cannot start
    hosted and the tab shows that its process exited.
  -->
  <Target Name="DeployOffscreenPlatform" AfterTargets="DeployQtRuntime">
    <Copy SourceFiles="$(QtDir)\plugins\platforms\qoffscreen$(QtLibSuffix).dll"
          DestinationFolder="$(OutDir)platforms"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
