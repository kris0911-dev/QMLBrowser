<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{8F1C4A21-6D3E-4B5A-9C10-2E7A5B840003}</ProjectGuid>
    <RootNamespace>QmlRenderer</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <!-- Whichever toolset this Visual Studio ships: v143 on 2022, v145 on 2026. -->
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' != 'Debug'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
    <Import Project="$(MSBuildThisFileDirectory)..\qt.props" />
  </ImportGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(RepoRoot)shared;$(ProjectDir)native;$(RepoRoot)canvas\include;$(QtInclude)\QtCore;$(QtInclude)\QtGui;$(QtGuiPrivateInclude);$(QtInclude)\QtNetwork;$(QtInclude)\QtQml;$(QtInclude)\QtQuick;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- Qt6EntryPoint supplies the WinMain that forwards to main(). -->
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>Qt6Core$(QtLibSuffix).lib;Qt6Gui$(QtLibSuffix).lib;Qt6Network$(QtLibSuffix).lib;Qt6Qml$(QtLibSuffix).lib;Qt6Quick$(QtLibSuffix).lib;Qt6EntryPoint$(QtLibSuffix).lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="OffscreenPage.cpp" />
    <ClCompile Include="PageView.cpp" />
    <ClCompile Include="native\CanvasLibrary.cpp" />
    <ClCompile Include="native\ClockFace.cpp" />
    <ClCompile Include="native\JuliaSet.cpp" />
    <ClCompile Include="native\NativeCanvas.cpp" />
    <ClCompile Include="native\NativeItems.cpp" />
    <ClCompile Include="native\WaveShape.cpp" />
    <ClCompile Include="$(RepoRoot)shared\InputEvents.cpp" />
    <ClCompile Include="$(RepoRoot)shared\IpcChannel.cpp" />
    <ClCompile Include="$(RepoRoot)shared\SharedPixels.cpp" />
    <!-- Generated by the moc and rcc steps below, before cl.exe runs. -->
    <ClCompile Include="$(QtGenDir)moc_OffscreenPage.cpp" />
    <ClCompile Include="$(QtGenDir)moc_PageView.cpp" />
    <ClCompile Include="$(QtGenDir)moc_ClockFace.cpp" />
    <ClCompile Include="$(QtGenDir)moc_JuliaSet.cpp" />
    <ClCompile Include="$(QtGenDir)moc_NativeCanvas.cpp" />
    <ClCompile Include="$(QtGenDir)moc_WaveShape.cpp" />
    <ClCompile Include="$(QtGenDir)moc_IpcChannel.cpp" />
    <ClCompile Include="$(QtGenDir)qrc_resources.cpp" />
  </ItemGroup>

  <ItemGroup>
    <CustomBuild Include="OffscreenPage.h">
      <Message>moc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\moc.exe" "%(FullPath)" -o "$(QtGenDir)moc_%(Filename).cpp" -f"%(Filename)%(Extension)"</Command>
      <Outputs>$(QtGenDir)moc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\moc.exe</AdditionalInputs>
    </CustomBuild>

    <CustomBuild Include="PageView.h">
      <Message>moc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\moc.exe" "%(FullPath)" -o "$(QtGenDir)moc_%(Filename).cpp" -f"%(Filename)%(Extension)"</Command>
      <Outputs>$(QtGenDir)moc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\moc.exe</AdditionalInputs>
    </CustomBuild>

    <CustomBuild Include="native\ClockFace.h">
      <Message>moc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\moc.exe" "%(FullPath)" -o "$(QtGenDir)moc_%(Filename).cpp" -f"%(Filename)%(Extension)"</Command>
      <Outputs>$(QtGenDir)moc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\moc.exe</AdditionalInputs>
    </CustomBuild>

    <CustomBuild Include="native\JuliaSet.h">
      <Message>moc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\moc.exe" "%(FullPath)" -o "$(QtGenDir)moc_%(Filename).cpp" -f"%(Filename)%(Extension)"</Command>
      <Outputs>$(QtGenDir)moc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\moc.exe</AdditionalInputs>
    </CustomBuild>

    <CustomBuild Include="native\NativeCanvas.h">
      <Message>moc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\moc.exe" "%(FullPath)" -o "$(QtGenDir)moc_%(Filename).cpp" -f"%(Filename)%(Extension)"</Command>
      <Outputs>$(QtGenDir)moc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\moc.exe</AdditionalInputs>
    </CustomBuild>

    <CustomBuild Include="native\WaveShape.h">
      <Message>moc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\moc.exe" "%(FullPath)" -o "$(QtGenDir)moc_%(Filename).cpp" -f"%(Filename)%(Extension)"</Command>
      <Outputs>$(QtGenDir)moc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\moc.exe</AdditionalInputs>
    </CustomBuild>

    <CustomBuild Include="$(RepoRoot)shared\IpcChannel.h">
      <Message>moc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\moc.exe" "%(FullPath)" -o "$(QtGenDir)moc_%(Filename).cpp" -f"%(Filename)%(Extension)"</Command>
      <Outputs>$(QtGenDir)moc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\moc.exe</AdditionalInputs>
    </CustomBuild>

    <CustomBuild Include="resources.qrc">
      <Message>rcc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\rcc.exe" "%(FullPath)" -name resources -o "$(QtGenDir)qrc_%(Filename).cpp"</Command>
      <Outputs>$(QtGenDir)qrc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\rcc.exe;$(ProjectDir)ui\Renderer.qml</AdditionalInputs>
    </CustomBuild>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!--
    Pages are downloaded at run time, so windeployqt cannot see what they
    import. deploy\site lists the modules the sample site needs from every
    Qt kit (Qt Quick Controls), and deploy\quick3d adds Qt Quick 3D when the
    kit has it, for 3d.qml.
  -->
  <PropertyGroup>
    <RendererQmlDirs>--qmldir &quot;$(ProjectDir)ui&quot; --qmldir &quot;$(ProjectDir)deploy\site&quot;</RendererQmlDirs>
    <RendererQmlDirs Condition="Exists('$(QtDir)\qml\QtQuick3D')">$(RendererQmlDirs) --qmldir &quot;$(ProjectDir)deploy\quick3d&quot;</RendererQmlDirs>
  </PropertyGroup>

  <!--
    windeployqt runs again when the QML it scans or this project changes,
    and when a module the site needs is missing from the output folder.
    Deploying only while the stamp was absent left output folders made
    before deploy\site existed without Qt Quick Controls, and every page
    importing it failed to load.
  -->
  <ItemGroup>
    <RendererDeployInput Include="$(MSBuildProjectFullPath);$(ProjectDir)ui\**\*.qml;$(ProjectDir)deploy\**\*.qml" />
  </ItemGroup>

  <Target Name="CheckQtRuntime" BeforeTargets="DeployQtRuntime">
    <Delete Files="$(OutDir)qtdeploy_renderer.stamp"
            Condition="!Exists('$(OutDir)qml\QtQuick\Controls\Basic\qmldir') Or !Exists('$(OutDir)qml\QtQuick\Templates\qmldir') Or (Exists('$(QtDir)\qml\QtQuick3D') And !Exists('$(OutDir)qml\QtQuick3D\qmldir'))" />
  </Target>

  <Target Name="DeployQtRuntime" AfterTargets="Link"
          Inputs="@(RendererDeployInput)" Outputs="$(OutDir)qtdeploy_renderer.stamp">
    <Exec Command="&quot;$(QtBin)\windeployqt.exe&quot; $(RendererQmlDirs) --no-translations --no-compiler-runtime &quot;$(TargetPath)&quot;" />
    <Touch Files="$(OutDir)qtdeploy_renderer.stamp" AlwaysCreate="true" />
  </Target>

</Project>
