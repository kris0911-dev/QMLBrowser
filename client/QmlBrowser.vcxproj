<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{8F1C4A21-6D3E-4B5A-9C10-2E7A5B840002}</ProjectGuid>
    <RootNamespace>QmlBrowser</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <!-- Whichever toolset this Visual Studio ships: v143 on 2022, v145 on 2026. -->
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' != 'Debug'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
    <Import Project="$(MSBuildThisFileDirectory)..\qt.props" />
  </ImportGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(RepoRoot)shared;$(QtInclude)\QtCore;$(QtInclude)\QtGui;$(QtInclude)\QtNetwork;$(QtInclude)\QtQml;$(QtInclude)\QtQuick;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- Qt6EntryPoint supplies the WinMain that forwards to main(). -->
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>Qt6Core$(QtLibSuffix).lib;Qt6Gui$(QtLibSuffix).lib;Qt6Network$(QtLibSuffix).lib;Qt6Qml$(QtLibSuffix).lib;Qt6Quick$(QtLibSuffix).lib;Qt6EntryPoint$(QtLibSuffix).lib;shell32.lib;dwmapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="BrowserHistory.cpp" />
    <ClCompile Include="BrowserTab.cpp" />
    <ClCompile Include="TabManager.cpp" />
    <ClCompile Include="TabViewport.cpp" />
    <ClCompile Include="WindowFrame.cpp" />
    <ClCompile Include="$(RepoRoot)shared\IpcChannel.cpp" />
    <!-- Generated by the moc and rcc steps below, before cl.exe runs. -->
    <ClCompile Include="$(QtGenDir)moc_BrowserHistory.cpp" />
    <ClCompile Include="$(QtGenDir)moc_BrowserTab.cpp" />
    <ClCompile Include="$(QtGenDir)moc_TabManager.cpp" />
    <ClCompile Include="$(QtGenDir)moc_TabViewport.cpp" />
    <ClCompile Include="$(QtGenDir)moc_IpcChannel.cpp" />
    <ClCompile Include="$(QtGenDir)qrc_resources.cpp" />
  </ItemGroup>

  <ItemGroup>
    <CustomBuild Include="BrowserHistory.h;BrowserTab.h;TabManager.h;TabViewport.h;$(RepoRoot)shared\IpcChannel.h">
      <Message>moc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\moc.exe" "%(FullPath)" -o "$(QtGenDir)moc_%(Filename).cpp" -f"%(Filename)%(Extension)"</Command>
      <Outputs>$(QtGenDir)moc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\moc.exe</AdditionalInputs>
    </CustomBuild>

    <!-- The browser chrome is compiled into the executable. -->
    <CustomBuild Include="resources.qrc">
      <Message>rcc %(Filename)%(Extension)</Message>
      <Command>if not exist "$(QtGenDir)" mkdir "$(QtGenDir)"
"$(QtBin)\rcc.exe" "%(FullPath)" -name resources -o "$(QtGenDir)qrc_%(Filename).cpp"</Command>
      <Outputs>$(QtGenDir)qrc_%(Filename).cpp</Outputs>
      <AdditionalInputs>$(QtBin)\rcc.exe;$(ProjectDir)ui\Browser.qml;$(ProjectDir)ui\ToolButton.qml;$(ProjectDir)ui\TabButton.qml</AdditionalInputs>
    </CustomBuild>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="DeployQtRuntime" AfterTargets="Link">
    <Exec Condition="!Exists('$(OutDir)qtdeploy_client.stamp')"
          Command="&quot;$(QtBin)\windeployqt.exe&quot; --qmldir &quot;$(ProjectDir)ui&quot; --no-translations --no-compiler-runtime &quot;$(TargetPath)&quot;" />
    <Touch Files="$(OutDir)qtdeploy_client.stamp" AlwaysCreate="true" />
  </Target>

</Project>
